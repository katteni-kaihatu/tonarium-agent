# Discord Developer Portal: Bot token, Guilds / Guild Messages / Message Content intents.
# Bot needs Create Public Threads and Send Messages in Threads in this channel.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: only decisions requiring a human are posted to this Forum channel.
DISCORD_DECISION_FORUM_ID=
# Mentioned on decisions; the only person whose answer settles an appeal against a declined request.
DISCORD_DECISION_MENTION_ID=
# Optional: channel for main release results. Empty means results are not posted.
DISCORD_RELEASE_CHANNEL_ID=

# Existing Tonarium checkout and GitHub repository
TONARIUM_REPO=C:\Users\neo\GitHub\tonarium-prototype
GITHUB_REPO=katteni-kaihatu/tonarium-prototype
RELEASE_BRANCH=develop
# The release role merges develop into MAIN_BRANCH every N minutes (0 disables it).
MAIN_BRANCH=main
MAIN_RELEASE_INTERVAL_MINUTES=15

# codex or claude. Subscription login is used by default.
INTAKE_PROVIDER=codex
PLANNING_PROVIDER=codex
CODING_PROVIDER=codex
INTEGRATION_PROVIDER=codex
TRANSLATION_PROVIDER=codex
# Set TRANSLATION_PROVIDER=openai and OPENAI_API_KEY to use the OpenAI API only for translation.
TRANSLATION_MODEL=gpt-6-luna
AGENT_AUTH_MODE=subscription
CODEX_MODEL=gpt-6.1-sol
CODEX_SPEED=fast
CODEX_REASONING_EFFORT=medium
# Optional override, e.g. {"pm":"花子","release":"太郎"}
TONARIUM_TEAM_NAMES=

# Admin console (/admin). Login uses Misskey OAuth on this instance.
MISSKEY_ORIGIN=https://misskey.resonite.love
# Comma-separated Misskey user IDs (the ID shown on the Misskey profile).
# These users always have every admin permission and cannot be demoted in the UI.
INITIAL_ADMIN_MISSKEY_IDS=
# Public origin of this dashboard, e.g. https://tonarium-agent.kokopi.me
# Used as the Misskey OAuth redirect origin and the avatar base URL.
# Empty means the request origin (or the public tunnel URL) is used.
ADMIN_PUBLIC_URL=

HOST=127.0.0.1
PORT=43879
MAX_WORKERS=15
RELEASE_BATCH_MINUTES=0
CHECKS_TIMEOUT_MINUTES=20
REQUIRED_PR_CHECK=web
AUTO_RELEASE=false
